APP_NAME=ReySoft-Asistencia
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://reysoft_asistencia:reysoft_asistencia@localhost:55432/reysoft_asistencia
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=reysoft-asistencia
JWT_AUDIENCE=reysoft-api
AUTH_COOKIE_NAME=reysoft_asistencia_token
PARENT_AUTH_COOKIE_NAME=reysoft_asistencia_parent_token
CSRF_PROTECTION_ENABLED=true
CSRF_COOKIE_NAME=reysoft_asistencia_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
REQUEST_ID_HEADER_NAME=X-Request-ID
CONTENT_TYPE_GUARD_ENABLED=true
ALLOWED_WRITE_CONTENT_TYPES=application/json,multipart/form-data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,*.vercel.app,reysoft-asistencia.vercel.app
INITIAL_SUPER_ADMIN_EMAIL=superadmin@reysoft-asistencia.com
INITIAL_SUPER_ADMIN_PASSWORD=SuperAdmin123!
DATABASE_POOL_MODE=default
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=school-logos
UPLOAD_DIR=uploads
MAX_LOGO_UPLOAD_BYTES=2097152
MAX_REQUEST_BODY_BYTES=10485760
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5
RATE_LIMIT_PARENT_AUTH_REQUESTS_PER_MINUTE=8
RATE_LIMIT_ATTENDANCE_REQUESTS_PER_MINUTE=60
RATE_LIMIT_IMPORT_REQUESTS_PER_HOUR=10
RATE_LIMIT_EXPORT_REQUESTS_PER_HOUR=30
